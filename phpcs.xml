<?xml version="1.0"?>
<ruleset name="Miguel">
	<description>Miguel Coding Standard</description>

    <arg name="basepath" value="./"/>

	<exclude-pattern>./vendor/*</exclude-pattern>
	<exclude-pattern>./tmp/*</exclude-pattern>
	<exclude-pattern>./run/*</exclude-pattern>
	<exclude-pattern>./wordpress/*</exclude-pattern>
	<exclude-pattern>./woocommerce/*</exclude-pattern>

	<!--
	Prevent errors caused by WordPress Coding Standards not supporting PHP 8.0+.
	See https://github.com/WordPress/WordPress-Coding-Standards/issues/2035
	-->
	<ini name="error_reporting" value="E_ALL &#38; ~E_DEPRECATED" />

    <config name="text_domain" value="miguel" />
	<!--
	The WordPress floor: 6.5, the oldest WordPress any CI leg exercises. It cannot go lower now
	that PHP 8.1 is required — WP 5.8 is the first release with PHP 8.1 support at all.
	The key is minimum_wp_version, not minimum_supported_wp_version — WPCS 3.0 renamed the option and
	3.0.1 is what is installed, so the old name is read by nothing.
	Keep in step with phpcs-woocommerce.xml.
	-->
	<config name="minimum_wp_version" value="6.5"/>

	<!--
	The PHP floor the plugin actually has: "Requires PHP: 8.1" in miguel.php and readme.txt, which
	WordPress enforces at activation, and the matrix leg tests.yml labels "Minimum supported
	version". Without this, the PHPCompatibility rule below has no target and silently checks
	nothing — a local run then passes code the WooCommerce sniffer rejects.

	Caveat worth knowing: the installed PHPCompatibility is 9.3.5, which predates PHP 8 and has no
	data for it. At 8.1- this rule no longer flags 7.3/7.4 features as too new and knows nothing
	about 8.x to flag instead, so it is close to decorative until a PHPCompatibility 10 ships.
	Keep in step with phpcs-woocommerce.xml.
	-->
	<config name="testVersion" value="8.1-"/>

	<!-- Rules -->
	<rule ref="WooCommerce-Core" />

	<!-- WooCommerce-Core does not pull these in, so the WP floor above had nothing reading it. -->
	<rule ref="WordPress.WP.DeprecatedFunctions" />
	<rule ref="WordPress.WP.DeprecatedParameters" />

    <rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="miguel" />
		</properties>
	</rule>

	<rule ref="PHPCompatibility">
		<exclude-pattern>tests/</exclude-pattern>
	</rule>
</ruleset>
