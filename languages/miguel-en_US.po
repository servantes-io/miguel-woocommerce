msgid "miguel_settings_description"
msgstr ""
"Discover following informations about settings:\n"
"• <a href=\"https://docs.miguel.servantes.cz/\" target=\"_blank\" rel=\"noopener noreferrer\">Documentation</a>\n"
"• <a href=\"https://app.servantes.cz/miguel/settings\" target=\"_blank\" rel=\"noopener noreferrer\">Get API key</a>"

msgid "Enable asynchronous generation"
msgstr "Enable asynchronous generation. Async generation handles large load on Miguel side. This setting is not required to set, Miguel handles large loads very well nowadays."

msgid "Send order emails from Miguel"
msgstr "Send order emails from Miguel"

msgid "When enabled, Miguel sends an email to the customer with links to download the books. When disabled, Miguel does not send any email."
msgstr "When enabled, Miguel sends an email to the customer with links to download the books. When disabled, Miguel does not send any email."

#: includes/admin/class-miguel-settings.php:94
msgid "Printed-book code suffix"
msgstr "Printed-book code suffix"

#: includes/admin/class-miguel-settings.php:95
msgid "Appended to a printed book's SKU to form its Miguel product code — e.g. \":print\" makes SKU \"harry-potter\" resolve as \"harry-potter:print\". Leave empty to disable printed-book pairing. Must match the suffix configured on the Miguel platform."
msgstr "Appended to a printed book's SKU to form its Miguel product code — e.g. \":print\" makes SKU \"harry-potter\" resolve as \"harry-potter:print\". Leave empty to disable printed-book pairing. Must match the suffix configured on the Miguel platform."

#: includes/admin/class-miguel-settings.php
msgid "Orders"
msgstr "Orders"

#: includes/admin/class-miguel-settings.php
msgid "Statuses that remove the order from Miguel"
msgstr "Statuses that remove the order from Miguel"

#: includes/admin/class-miguel-settings.php
msgid "Reaching one of these statuses removes the order from Miguel: the customer loses access to the books and their download links stop working. Trashing an order always removes it, whatever is selected here."
msgstr "Reaching one of these statuses removes the order from Miguel: the customer loses access to the books and their download links stop working. Trashing an order always removes it, whatever is selected here."

#: includes/admin/class-miguel-settings.php
msgid "Automatic order status change"
msgstr "Automatic order status change"

#: includes/admin/class-miguel-settings.php
msgid "When Miguel finishes processing an order, move it to the status chosen here. Leave both on \"Do not change status\" to disable."
msgstr "When Miguel finishes processing an order, move it to the status chosen here. Leave both on \"Do not change status\" to disable."

#: includes/admin/class-miguel-settings.php
msgid "Order with only Miguel books"
msgstr "Order with only Miguel books"

#: includes/admin/class-miguel-settings.php
msgid "Order with Miguel books and other products"
msgstr "Order with Miguel books and other products"

#: includes/admin/class-miguel-settings.php
msgid "Products"
msgstr "Products"

